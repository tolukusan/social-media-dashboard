DATABASE_URL="postgresql://postgres:your-local-password@localhost:5432/postgres?schema=social_media_dashboard"
API_PORT=4000
APP_ORIGIN=http://localhost:3000
REPORTING_TIMEZONE=Africa/Lagos
SESSION_COOKIE_NAME=smd_session
SESSION_TTL_DAYS=7
NODE_ENV=development
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Marketwise <no-reply@example.invalid>

# Read-only provider access tokens stay on the API server. Setup works with these empty.
# Configure supported API versions after developer-app access is approved.
INTEGRATION_META_ACCESS_TOKEN=
INTEGRATION_META_API_VERSION=
INTEGRATION_LINKEDIN_ACCESS_TOKEN=
INTEGRATION_LINKEDIN_API_VERSION=
INTEGRATION_ZOHO_ACCESS_TOKEN=
INTEGRATIONS_SCHEDULER_ENABLED=true

# OAuth secrets are server-only. Generate a random 32-byte key and base64-encode it.
INTEGRATION_OAUTH_ENCRYPTION_KEY=
# Production must use the exact public API origin and explicitly allowlist it.
INTEGRATION_OAUTH_API_ORIGIN=http://localhost:4000
INTEGRATION_OAUTH_ALLOWED_CALLBACK_ORIGINS=http://localhost:4000
INTEGRATION_META_OAUTH_CLIENT_ID=
INTEGRATION_META_OAUTH_CLIENT_SECRET=
INTEGRATION_LINKEDIN_OAUTH_CLIENT_ID=
INTEGRATION_LINKEDIN_OAUTH_CLIENT_SECRET=
INTEGRATION_ZOHO_OAUTH_CLIENT_ID=
INTEGRATION_ZOHO_OAUTH_CLIENT_SECRET=
INTEGRATION_GOOGLE_OAUTH_CLIENT_ID=
INTEGRATION_GOOGLE_OAUTH_CLIENT_SECRET=
