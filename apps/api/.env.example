# API and database
NODE_ENV=development
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/social_media_dashboard
APP_ORIGIN=http://localhost:3000
API_PORT=4000
SESSION_COOKIE_NAME=smd_session

# Reporting
REPORTING_TIMEZONE=UTC

# Optional local Administrator seed
SEED_ADMIN_EMAIL=
