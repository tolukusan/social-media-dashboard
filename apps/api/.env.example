# Local API configuration. Copy to apps/api/.env and fill in locally.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
API_PORT=4000
NODE_ENV=development
REPORTING_TIMEZONE=Africa/Lagos
SESSION_COOKIE_NAME=smd_session
# Optional: used by prisma:seed to create a local administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Account OAuth callback. Register this exact URL with each provider app.
INTEGRATION_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/accounts/oauth/callback

# Generate once with: openssl rand -base64 32
# Keep it stable and private; it encrypts saved OAuth tokens.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Meta app shared by Facebook Pages and Instagram professional accounts.
INTEGRATION_META_APP_ID=
INTEGRATION_META_APP_SECRET=
INTEGRATION_META_API_VERSION=
# Existing campaign-level ads imports use their own administrator-managed tokens.
INTEGRATION_META_ACCESS_TOKEN=

# LinkedIn Marketing / Community Management app.
INTEGRATION_LINKEDIN_CLIENT_ID=
INTEGRATION_LINKEDIN_CLIENT_SECRET=
INTEGRATION_LINKEDIN_API_VERSION=
INTEGRATION_LINKEDIN_ACCESS_TOKEN=

# Google OAuth app with YouTube Data API and YouTube Analytics API enabled.
INTEGRATION_GOOGLE_CLIENT_ID=
INTEGRATION_GOOGLE_CLIENT_SECRET=

# Zoho Campaigns OAuth app.
INTEGRATION_ZOHO_CLIENT_ID=
INTEGRATION_ZOHO_CLIENT_SECRET=
INTEGRATION_ZOHO_REGION=US
INTEGRATION_ZOHO_ACCESS_TOKEN=

# Set false to disable the hourly account sync worker.
INTEGRATIONS_SCHEDULER_ENABLED=true

# Optional: SMTP for account recovery emails and a report font for PDFs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_FONT_PATH=

# Read-only marketing provider tokens. Keep actual values in ignored server configuration.
INTEGRATION_META_ACCESS_TOKEN=
INTEGRATION_META_API_VERSION=
INTEGRATION_LINKEDIN_ACCESS_TOKEN=
INTEGRATION_LINKEDIN_API_VERSION=
INTEGRATION_ZOHO_ACCESS_TOKEN=
INTEGRATIONS_SCHEDULER_ENABLED=true

# OAuth secrets are server-only. Generate a random 32-byte key and base64-encode it.
INTEGRATION_OAUTH_ENCRYPTION_KEY=
# Production must use the exact public API origin and explicitly allowlist it.
INTEGRATION_OAUTH_API_ORIGIN=http://localhost:4000
INTEGRATION_OAUTH_ALLOWED_CALLBACK_ORIGINS=http://localhost:4000
INTEGRATION_META_OAUTH_CLIENT_ID=
INTEGRATION_META_OAUTH_CLIENT_SECRET=
INTEGRATION_LINKEDIN_OAUTH_CLIENT_ID=
INTEGRATION_LINKEDIN_OAUTH_CLIENT_SECRET=
INTEGRATION_ZOHO_OAUTH_CLIENT_ID=
INTEGRATION_ZOHO_OAUTH_CLIENT_SECRET=
INTEGRATION_GOOGLE_OAUTH_CLIENT_ID=
INTEGRATION_GOOGLE_OAUTH_CLIENT_SECRET=
