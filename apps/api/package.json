{
  "name": "@smd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "prettier --check src --ignore-path .prettierignore prisma prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm test:unit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:unit": "vitest run",
    "test:db:prepare": "tsx scripts/prepare-test-database.ts",
    "test:integration": "tsx scripts/run-integration.ts",
    "test:e2e:prepare": "tsx scripts/prepare-e2e-users.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "recovery:cleanup": "tsx prisma/cleanup-password-recovery.ts",
    "session:cleanup": "tsx prisma/cleanup-sessions.ts",
    "demo:prepare": "tsx prisma/demo.ts",
    "test:load": "tsx scripts/run-load.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.1.0",
    "@smd/shared": "workspace:*",
    "argon2": "^0.31.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.0.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "prisma": "^7.1.0",
    "tsx": "^4.20.5",
    "vitest": "^5.0.3"
  }
}
