generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["social_media_dashboard"]
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED

  @@schema("social_media_dashboard")
}

enum MetricKind {
  RAW
  DERIVED

  @@schema("social_media_dashboard")
}

enum MetricUnit {
  COUNT
  PERCENT
  CURRENCY
  POSITION
  DECIMAL

  @@schema("social_media_dashboard")
}

enum AggregationStrategy {
  SUM
  WEIGHTED_AVERAGE
  FIRST
  LAST
  DERIVED

  @@schema("social_media_dashboard")
}

enum PerformanceRecordStatus {
  ACTIVE
  ARCHIVED

  @@schema("social_media_dashboard")
}

enum TargetPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CAMPAIGN

  @@schema("social_media_dashboard")
}

enum TargetScopeType {
  GLOBAL
  CHANNEL
  PLATFORM
  CAMPAIGN

  @@schema("social_media_dashboard")
}

enum ComparisonRule {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER

  @@schema("social_media_dashboard")
}

enum ImportBatchStatus {
  PREVIEW
  READY
  IMPORTING
  COMPLETED
  FAILED
  REJECTED

  @@schema("social_media_dashboard")
}

enum ImportRowStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFLICT

  @@schema("social_media_dashboard")
}

model ReportingSettings {
  id                String   @id @default("organisation")
  reportingCurrency String?  @db.VarChar(3)
  updatedAt         DateTime @updatedAt

  @@schema("social_media_dashboard")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("social_media_dashboard")
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  roleId                    String                  @db.Uuid
  role                      Role                    @relation(fields: [roleId], references: [id])
  name                      String
  email                     String                  @unique
  passwordHash              String
  active                    Boolean                 @default(true)
  lastLoginAt               DateTime?
  deactivatedAt             DateTime?
  responsibleCampaigns      Campaign[]              @relation("ResponsibleUser")
  createdCampaigns          Campaign[]              @relation("CreatedCampaigns")
  updatedCampaigns          Campaign[]              @relation("UpdatedCampaigns")
  createdPerformanceRecords PerformanceRecord[]     @relation("CreatedPerformanceRecords")
  updatedPerformanceRecords PerformanceRecord[]     @relation("UpdatedPerformanceRecords")
  importBatches             ImportBatch[]
  sessions                  Session[]
  passwordRecoveryTokens    PasswordRecoveryToken[]
  createdTargets            KpiTarget[]             @relation("CreatedTargets")
  auditEvents               AuditLog[]
  integrationConnections    IntegrationConnection[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@schema("social_media_dashboard")
}

model MarketingChannel {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  active           Boolean           @default(true)
  archivedAt       DateTime?
  platforms        Platform[]
  campaignChannels CampaignChannel[]
  channelMetrics   ChannelMetric[]
  targets          KpiTarget[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model Platform {
  id                     String                  @id @default(uuid()) @db.Uuid
  channelId              String                  @db.Uuid
  channel                MarketingChannel        @relation(fields: [channelId], references: [id])
  code                   String
  name                   String
  description            String?
  active                 Boolean                 @default(true)
  archivedAt             DateTime?
  campaignPlatforms      CampaignPlatform[]
  targets                KpiTarget[]
  integrationConnections IntegrationConnection[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([channelId, code])
  @@schema("social_media_dashboard")
}

model Campaign {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  objective         String?
  targetAudience    String?
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date
  status            CampaignStatus    @default(PLANNED)
  budget            Decimal?          @db.Decimal(18, 2)
  responsibleUserId String            @db.Uuid
  responsibleUser   User              @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  createdByUserId   String            @db.Uuid
  createdByUser     User              @relation("CreatedCampaigns", fields: [createdByUserId], references: [id])
  updatedByUserId   String            @db.Uuid
  updatedByUser     User              @relation("UpdatedCampaigns", fields: [updatedByUserId], references: [id])
  notes             String?
  archivedAt        DateTime?
  campaignChannels  CampaignChannel[]
  targets           KpiTarget[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model CampaignChannel {
  id                String             @id @default(uuid()) @db.Uuid
  campaignId        String             @db.Uuid
  campaign          Campaign           @relation(fields: [campaignId], references: [id])
  channelId         String             @db.Uuid
  channel           MarketingChannel   @relation(fields: [channelId], references: [id])
  campaignPlatforms CampaignPlatform[]
  createdAt         DateTime           @default(now())

  @@unique([campaignId, channelId])
  @@schema("social_media_dashboard")
}

model CampaignPlatform {
  id                 String              @id @default(uuid()) @db.Uuid
  campaignChannelId  String              @db.Uuid
  campaignChannel    CampaignChannel     @relation(fields: [campaignChannelId], references: [id])
  platformId         String              @db.Uuid
  platform           Platform            @relation(fields: [platformId], references: [id])
  performanceRecords PerformanceRecord[]
  integrationMapping IntegrationMapping?
  createdAt          DateTime            @default(now())

  @@unique([campaignChannelId, platformId])
  @@schema("social_media_dashboard")
}

model MetricDefinition {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique
  name                String
  description         String?
  kind                MetricKind
  unit                MetricUnit
  aggregationStrategy AggregationStrategy
  active              Boolean                  @default(true)
  channelMetrics      ChannelMetric[]
  performanceValues   PerformanceMetricValue[]
  kpiDefinitions      KpiDefinition[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@schema("social_media_dashboard")
}

model ChannelMetric {
  id                 String           @id @default(uuid()) @db.Uuid
  channelId          String           @db.Uuid
  channel            MarketingChannel @relation(fields: [channelId], references: [id])
  metricDefinitionId String           @db.Uuid
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id])
  inputEnabled       Boolean          @default(true)
  displayOrder       Int              @default(0)
  active             Boolean          @default(true)

  @@unique([channelId, metricDefinitionId])
  @@schema("social_media_dashboard")
}

model PerformanceRecord {
  id                   String                   @id @default(uuid()) @db.Uuid
  campaignPlatformId   String                   @db.Uuid
  campaignPlatform     CampaignPlatform         @relation(fields: [campaignPlatformId], references: [id])
  recordDate           DateTime                 @db.Date
  notes                String?
  status               PerformanceRecordStatus  @default(ACTIVE)
  createdByUserId      String                   @db.Uuid
  createdByUser        User                     @relation("CreatedPerformanceRecords", fields: [createdByUserId], references: [id])
  updatedByUserId      String                   @db.Uuid
  updatedByUser        User                     @relation("UpdatedPerformanceRecords", fields: [updatedByUserId], references: [id])
  metricValues         PerformanceMetricValue[]
  importBatchId        String?                  @db.Uuid
  importBatch          ImportBatch?             @relation(fields: [importBatchId], references: [id])
  archivedAt           DateTime?
  integrationMappingId String?                  @db.Uuid
  integrationMapping   IntegrationMapping?      @relation(fields: [integrationMappingId], references: [id], onDelete: Restrict)
  integrationManaged   Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([campaignPlatformId, recordDate])
  @@index([importBatchId])
  @@index([integrationMappingId])
  @@schema("social_media_dashboard")
}

enum IntegrationProvider {
  FACEBOOK_ADS
  INSTAGRAM_ADS
  LINKEDIN_ADS
  ZOHO_CAMPAIGNS
  FACEBOOK_ORGANIC
  INSTAGRAM_ORGANIC
  LINKEDIN_ORGANIC
  YOUTUBE_ANALYTICS

  @@schema("social_media_dashboard")
}

enum IntegrationRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  BLOCKED

  @@schema("social_media_dashboard")
}

model IntegrationConnection {
  id                  String                            @id @default(uuid()) @db.Uuid
  provider            IntegrationProvider
  platformId          String                            @db.Uuid
  platform            Platform                          @relation(fields: [platformId], references: [id], onDelete: Restrict)
  displayName         String                            @db.VarChar(120)
  externalAccountId   String                            @db.VarChar(160)
  credentialReference String                            @db.VarChar(100)
  sourceTimezone      String                            @db.VarChar(100)
  currency            String?                           @db.VarChar(3)
  region              String                            @default("US") @db.VarChar(10)
  active              Boolean                           @default(true)
  autoSync            Boolean                           @default(false)
  nextSyncAt          DateTime                          @default(now())
  leaseToken          String?                           @db.Uuid
  leaseUntil          DateTime?
  configuredByUserId  String                            @db.Uuid
  configuredByUser    User                              @relation(fields: [configuredByUserId], references: [id], onDelete: Restrict)
  mappings            IntegrationMapping[]
  runs                IntegrationRun[]
  accountRecords      ConnectedAccountAnalyticsRecord[]
  metricValues        PerformanceMetricValue[]
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([provider, region, externalAccountId])
  @@index([active, autoSync, nextSyncAt])
  @@schema("social_media_dashboard")
}

model IntegrationMapping {
  id                 String                @id @default(uuid()) @db.Uuid
  connectionId       String                @db.Uuid
  connection         IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  campaignPlatformId String                @unique @db.Uuid
  campaignPlatform   CampaignPlatform      @relation(fields: [campaignPlatformId], references: [id], onDelete: Restrict)
  externalCampaignId String                @db.VarChar(160)
  performanceRecords PerformanceRecord[]
  createdAt          DateTime              @default(now())

  @@unique([connectionId, externalCampaignId])
  @@schema("social_media_dashboard")
}

model IntegrationRun {
  id               String                @id @default(uuid()) @db.Uuid
  connectionId     String                @db.Uuid
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  status           IntegrationRunStatus  @default(RUNNING)
  fromDate         DateTime              @db.Date
  toDate           DateTime              @db.Date
  triggeredBy      String                @db.VarChar(20)
  createdRecords   Int                   @default(0)
  updatedRecords   Int                   @default(0)
  unchangedRecords Int                   @default(0)
  conflicts        Int                   @default(0)
  errorCode        String?               @db.VarChar(60)
  summary          Json?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?

  @@index([connectionId, startedAt])
  @@schema("social_media_dashboard")
}

enum AccountAnalyticsScope {
  ACCOUNT
  CONTENT

  @@schema("social_media_dashboard")
}

model IntegrationMetricDefinition {
  id                  String                        @id @default(uuid()) @db.Uuid
  provider            IntegrationProvider
  code                String                        @db.VarChar(80)
  scope               AccountAnalyticsScope         @default(ACCOUNT)
  name                String                        @db.VarChar(120)
  description         String
  sourceField         String                        @db.VarChar(120)
  definitionVersion   Int                           @default(1)
  unit                MetricUnit
  aggregationStrategy AggregationStrategy
  weightingMetricCode String?                       @db.VarChar(80)
  nonNegative         Boolean                       @default(true)
  retentionDays       Int?
  active              Boolean                       @default(true)
  metricValues        ConnectedAccountMetricValue[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([provider, code, scope, definitionVersion])
  @@index([provider, scope, active])
  @@schema("social_media_dashboard")
}

model ConnectedAccountAnalyticsRecord {
  id               String                        @id @default(uuid()) @db.Uuid
  connectionId     String                        @db.Uuid
  connection       IntegrationConnection         @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  recordDate       DateTime                      @db.Date
  scope            AccountAnalyticsScope         @default(ACCOUNT)
  sourceObjectId   String                        @default("ACCOUNT") @db.VarChar(160)
  sourceApiVersion String?                       @db.VarChar(40)
  retrievedAt      DateTime                      @default(now())
  metricValues     ConnectedAccountMetricValue[]
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@unique([connectionId, recordDate, scope, sourceObjectId])
  @@index([connectionId, recordDate])
  @@schema("social_media_dashboard")
}

model ConnectedAccountMetricValue {
  id                  String                          @id @default(uuid()) @db.Uuid
  recordId            String                          @db.Uuid
  record              ConnectedAccountAnalyticsRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  metricDefinitionId  String                          @db.Uuid
  metricDefinition    IntegrationMetricDefinition     @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  value               Decimal                         @db.Decimal(24, 6)
  sourceDataExpiresAt DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([recordId, metricDefinitionId])
  @@index([sourceDataExpiresAt])
  @@schema("social_media_dashboard")
}

model PerformanceMetricValue {
  id                  String                 @id @default(uuid()) @db.Uuid
  performanceRecordId String                 @db.Uuid
  performanceRecord   PerformanceRecord      @relation(fields: [performanceRecordId], references: [id])
  metricDefinitionId  String                 @db.Uuid
  metricDefinition    MetricDefinition       @relation(fields: [metricDefinitionId], references: [id])
  sourceConnectionId  String?                @db.Uuid
  sourceConnection    IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: Restrict)
  value               Decimal                @db.Decimal(24, 6)
  sourceDataExpiresAt DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([performanceRecordId, metricDefinitionId])
  @@index([sourceConnectionId, sourceDataExpiresAt])
  @@schema("social_media_dashboard")
}

model KpiDefinition {
  id                 String           @id @default(uuid()) @db.Uuid
  metricDefinitionId String           @db.Uuid
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id])
  name               String
  description        String?
  active             Boolean          @default(true)
  targets            KpiTarget[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([metricDefinitionId])
  @@schema("social_media_dashboard")
}

model KpiTarget {
  id              String            @id @default(uuid()) @db.Uuid
  kpiDefinitionId String            @db.Uuid
  kpiDefinition   KpiDefinition     @relation(fields: [kpiDefinitionId], references: [id])
  periodType      TargetPeriodType
  targetValue     Decimal           @db.Decimal(18, 6)
  scopeType       TargetScopeType   @default(GLOBAL)
  channelId       String?           @db.Uuid
  channel         MarketingChannel? @relation(fields: [channelId], references: [id])
  platformId      String?           @db.Uuid
  platform        Platform?         @relation(fields: [platformId], references: [id])
  campaignId      String?           @db.Uuid
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  comparisonRule  ComparisonRule
  effectiveFrom   DateTime          @db.Date
  effectiveTo     DateTime?         @db.Date
  createdByUserId String            @db.Uuid
  createdByUser   User              @relation("CreatedTargets", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
  @@schema("social_media_dashboard")
}

model PasswordRecoveryToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash    String    @unique
  emailAtIssue String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?

  @@index([userId, usedAt, revokedAt, expiresAt])
  @@schema("social_media_dashboard")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@schema("social_media_dashboard")
}

model ImportBatch {
  id                 String              @id @default(uuid()) @db.Uuid
  sourceType         String?
  sourcePlatform     String?
  displayName        String?
  originalFilename   String
  mimeType           String?
  checksum           String
  importedByUserId   String              @db.Uuid
  importedByUser     User                @relation(fields: [importedByUserId], references: [id])
  status             ImportBatchStatus   @default(PREVIEW)
  totalRows          Int                 @default(0)
  acceptedRows       Int                 @default(0)
  rejectedRows       Int                 @default(0)
  warningCount       Int                 @default(0)
  errorSummary       Json?
  mapping            Json?
  selectedSheet      String?
  completedAt        DateTime?
  rows               ImportRow[]
  performanceRecords PerformanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([checksum])
  @@index([importedByUserId, createdAt])
  @@schema("social_media_dashboard")
}

model ImportRow {
  id                String          @id @default(uuid()) @db.Uuid
  importBatchId     String          @db.Uuid
  importBatch       ImportBatch     @relation(fields: [importBatchId], references: [id])
  sourceRowNumber   Int
  sheetName         String?
  status            ImportRowStatus @default(PENDING)
  rawData           Json
  normalizedPreview Json?
  errors            Json?
  warnings          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([importBatchId, sourceRowNumber, sheetName])
  @@index([importBatchId, status])
  @@schema("social_media_dashboard")
}
