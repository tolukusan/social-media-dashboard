generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["social_media_dashboard"]
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED

  @@schema("social_media_dashboard")
}

enum MetricKind {
  RAW
  DERIVED

  @@schema("social_media_dashboard")
}

enum MetricUnit {
  COUNT
  PERCENT
  CURRENCY
  POSITION
  DECIMAL

  @@schema("social_media_dashboard")
}

enum AggregationStrategy {
  SUM
  WEIGHTED_AVERAGE
  FIRST
  LAST
  DERIVED

  @@schema("social_media_dashboard")
}

enum PerformanceRecordStatus {
  ACTIVE
  ARCHIVED

  @@schema("social_media_dashboard")
}

enum TargetPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CAMPAIGN

  @@schema("social_media_dashboard")
}

enum TargetScopeType {
  GLOBAL
  CHANNEL
  PLATFORM
  CAMPAIGN

  @@schema("social_media_dashboard")
}

enum ComparisonRule {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER

  @@schema("social_media_dashboard")
}

enum ImportBatchStatus {
  PREVIEW
  READY
  IMPORTING
  COMPLETED
  FAILED
  REJECTED

  @@schema("social_media_dashboard")
}

enum ImportRowStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFLICT

  @@schema("social_media_dashboard")
}

enum DatasetManagementCapability {
  MANAGEABLE
  HISTORICAL_PROTECTED

  @@schema("social_media_dashboard")
}

enum DatasetImportOperation {
  CREATE
  REPLACE

  @@schema("social_media_dashboard")
}

model ReportingSettings {
  id                String   @id @default("organisation")
  reportingCurrency String?  @db.VarChar(3)
  updatedAt         DateTime @updatedAt

  @@schema("social_media_dashboard")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  active      Boolean          @default(true)
  users       User[]
  invitations UserInvitation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("social_media_dashboard")
}

model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  roleId                    String                    @db.Uuid
  role                      Role                      @relation(fields: [roleId], references: [id])
  name                      String
  email                     String                    @unique
  passwordHash              String
  active                    Boolean                   @default(true)
  lastLoginAt               DateTime?
  deactivatedAt             DateTime?
  responsibleCampaigns      Campaign[]                @relation("ResponsibleUser")
  createdCampaigns          Campaign[]                @relation("CreatedCampaigns")
  updatedCampaigns          Campaign[]                @relation("UpdatedCampaigns")
  createdPerformanceRecords PerformanceRecord[]       @relation("CreatedPerformanceRecords")
  updatedPerformanceRecords PerformanceRecord[]       @relation("UpdatedPerformanceRecords")
  importBatches             ImportBatch[]
  createdDatasets           Dataset[]
  createdImportTemplates    DatasetImportTemplate[]
  sessions                  Session[]
  passwordRecoveryTokens    PasswordRecoveryToken[]
  createdTargets            KpiTarget[]               @relation("CreatedTargets")
  auditEvents               AuditLog[]
  integrationConnections    IntegrationConnection[]
  connectedAccounts         ConnectedAccount[]
  accountOAuthStates        AccountOAuthState[]
  requestedAccountSyncJobs  ConnectedAccountSyncJob[] @relation("AccountSyncRequestedBy")
  integrationOAuthAttempts  IntegrationOAuthAttempt[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@schema("social_media_dashboard")
}

model MarketingChannel {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  active           Boolean           @default(true)
  archivedAt       DateTime?
  platforms        Platform[]
  campaignChannels CampaignChannel[]
  channelMetrics   ChannelMetric[]
  targets          KpiTarget[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model Platform {
  id                     String                  @id @default(uuid()) @db.Uuid
  channelId              String                  @db.Uuid
  channel                MarketingChannel        @relation(fields: [channelId], references: [id])
  code                   String
  name                   String
  description            String?
  active                 Boolean                 @default(true)
  archivedAt             DateTime?
  campaignPlatforms      CampaignPlatform[]
  targets                KpiTarget[]
  integrationConnections IntegrationConnection[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([channelId, code])
  @@schema("social_media_dashboard")
}

model Campaign {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  objective         String?
  targetAudience    String?
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date
  status            CampaignStatus    @default(PLANNED)
  budget            Decimal?          @db.Decimal(18, 2)
  responsibleUserId String            @db.Uuid
  responsibleUser   User              @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  createdByUserId   String            @db.Uuid
  createdByUser     User              @relation("CreatedCampaigns", fields: [createdByUserId], references: [id])
  updatedByUserId   String            @db.Uuid
  updatedByUser     User              @relation("UpdatedCampaigns", fields: [updatedByUserId], references: [id])
  notes             String?
  archivedAt        DateTime?
  campaignChannels  CampaignChannel[]
  targets           KpiTarget[]
  datasets          Dataset[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model CampaignChannel {
  id                String             @id @default(uuid()) @db.Uuid
  campaignId        String             @db.Uuid
  campaign          Campaign           @relation(fields: [campaignId], references: [id])
  channelId         String             @db.Uuid
  channel           MarketingChannel   @relation(fields: [channelId], references: [id])
  campaignPlatforms CampaignPlatform[]
  createdAt         DateTime           @default(now())

  @@unique([campaignId, channelId])
  @@schema("social_media_dashboard")
}

model CampaignPlatform {
  id                 String              @id @default(uuid()) @db.Uuid
  campaignChannelId  String              @db.Uuid
  campaignChannel    CampaignChannel     @relation(fields: [campaignChannelId], references: [id])
  platformId         String              @db.Uuid
  platform           Platform            @relation(fields: [platformId], references: [id])
  performanceRecords PerformanceRecord[]
  integrationMapping IntegrationMapping?
  createdAt          DateTime            @default(now())

  @@unique([campaignChannelId, platformId])
  @@schema("social_media_dashboard")
}

model MetricDefinition {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique
  name                String
  description         String?
  kind                MetricKind
  unit                MetricUnit
  aggregationStrategy AggregationStrategy
  active              Boolean                  @default(true)
  channelMetrics      ChannelMetric[]
  performanceValues   PerformanceMetricValue[]
  kpiDefinitions      KpiDefinition[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@schema("social_media_dashboard")
}

model ChannelMetric {
  id                 String           @id @default(uuid()) @db.Uuid
  channelId          String           @db.Uuid
  channel            MarketingChannel @relation(fields: [channelId], references: [id])
  metricDefinitionId String           @db.Uuid
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id])
  inputEnabled       Boolean          @default(true)
  displayOrder       Int              @default(0)
  active             Boolean          @default(true)

  @@unique([channelId, metricDefinitionId])
  @@schema("social_media_dashboard")
}

model PerformanceRecord {
  id                   String                   @id @default(uuid()) @db.Uuid
  campaignPlatformId   String                   @db.Uuid
  campaignPlatform     CampaignPlatform         @relation(fields: [campaignPlatformId], references: [id])
  recordDate           DateTime                 @db.Date
  notes                String?
  status               PerformanceRecordStatus  @default(ACTIVE)
  createdByUserId      String                   @db.Uuid
  createdByUser        User                     @relation("CreatedPerformanceRecords", fields: [createdByUserId], references: [id])
  updatedByUserId      String                   @db.Uuid
  updatedByUser        User                     @relation("UpdatedPerformanceRecords", fields: [updatedByUserId], references: [id])
  metricValues         PerformanceMetricValue[]
  importBatchId        String?                  @db.Uuid
  importBatch          ImportBatch?             @relation(fields: [importBatchId], references: [id])
  archivedAt           DateTime?
  integrationMappingId String?                  @db.Uuid
  integrationMapping   IntegrationMapping?      @relation(fields: [integrationMappingId], references: [id], onDelete: Restrict)
  integrationManaged   Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([campaignPlatformId, recordDate])
  @@index([importBatchId])
  @@index([integrationMappingId])
  @@schema("social_media_dashboard")
}

enum IntegrationProvider {
  FACEBOOK_ADS
  INSTAGRAM_ADS
  LINKEDIN_ADS
  ZOHO_CAMPAIGNS
  FACEBOOK_ORGANIC
  INSTAGRAM_ORGANIC
  LINKEDIN_ORGANIC
  YOUTUBE_ANALYTICS

  @@schema("social_media_dashboard")
}

enum IntegrationRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  BLOCKED

  @@schema("social_media_dashboard")
}

enum ConnectedAccountProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  ZOHO_CAMPAIGNS

  @@schema("social_media_dashboard")
}

enum IntegrationOAuthCredentialStatus {
  CONNECTED
  REAUTH_REQUIRED

  @@schema("social_media_dashboard")
}

enum ConnectedAccountKind {
  SOCIAL
  EMAIL

  @@schema("social_media_dashboard")
}

enum IntegrationCredentialMode {
  SERVER_ENVIRONMENT
  OAUTH

  @@schema("social_media_dashboard")
}

model AccountOAuthState {
  id         String                   @id @default(uuid()) @db.Uuid
  provider   ConnectedAccountProvider
  stateHash  String                   @unique @db.Char(64)
  userId     String                   @db.Uuid
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@index([expiresAt, consumedAt])
  @@schema("social_media_dashboard")
}

model ConnectedAccount {
  id                         String                            @id @default(uuid()) @db.Uuid
  provider                   ConnectedAccountProvider
  kind                       ConnectedAccountKind
  externalAccountId          String                            @db.VarChar(180)
  displayName                String                            @db.VarChar(160)
  handle                     String?                           @db.VarChar(160)
  profileUrl                 String?                           @db.VarChar(500)
  profileMetadataExpiresAt   DateTime?
  credentialCiphertext       String?                           @db.Text
  tokenExpiresAt             DateTime?
  connectedByUserId          String                            @db.Uuid
  connectedByUser            User                              @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  active                     Boolean                           @default(true)
  connectedAt                DateTime                          @default(now())
  lastSyncedAt               DateTime?
  lastSyncErrorCode          String?                           @db.VarChar(60)
  historyBootstrapEnqueuedAt DateTime?
  accountAnalyticsRecords    ConnectedAccountAnalyticsRecord[]
  syncJobs                   ConnectedAccountSyncJob[]
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt

  @@unique([provider, externalAccountId])
  @@index([kind, active, provider])
  @@schema("social_media_dashboard")
}

enum ConnectedAccountSyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED

  @@schema("social_media_dashboard")
}

enum ConnectedAccountSyncJobSource {
  MANUAL
  SCHEDULED
  OAUTH

  @@schema("social_media_dashboard")
}

enum ConnectedAccountSyncChunkStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("social_media_dashboard")
}

model ConnectedAccountSyncJob {
  id                       String                        @id @default(uuid()) @db.Uuid
  connectedAccountId       String                        @db.Uuid
  connectedAccount         ConnectedAccount              @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  requestedFrom            DateTime                      @db.Date
  requestedTo              DateTime                      @db.Date
  fetchFrom                DateTime?                     @db.Date
  fetchTo                  DateTime?                     @db.Date
  source                   ConnectedAccountSyncJobSource
  status                   ConnectedAccountSyncJobStatus @default(QUEUED)
  requestedByUserId        String?                       @db.Uuid
  requestedByUser          User?                         @relation("AccountSyncRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime                      @default(now())
  startedAt                DateTime?
  updatedAt                DateTime                      @updatedAt
  completedAt              DateTime?
  snapshotRecordedAt       DateTime?
  contentRefreshRecordedAt DateTime?
  leaseToken               String?                       @db.Uuid
  leaseUntil               DateTime?
  finalErrorCode           String?                       @db.VarChar(60)
  chunks                   ConnectedAccountSyncChunk[]

  @@index([connectedAccountId, status, createdAt])
  @@index([status, leaseUntil, createdAt])
  @@index([completedAt])
  @@schema("social_media_dashboard")
}

model ConnectedAccountSyncChunk {
  id               String                          @id @default(uuid()) @db.Uuid
  jobId            String                          @db.Uuid
  job              ConnectedAccountSyncJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromDate         DateTime                        @db.Date
  toDate           DateTime                        @db.Date
  sequence         Int
  status           ConnectedAccountSyncChunkStatus @default(QUEUED)
  attemptCount     Int                             @default(0)
  nextAttemptAt    DateTime                        @default(now())
  observationCount Int                             @default(0)
  errorCode        String?                         @db.VarChar(60)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([jobId, sequence])
  @@index([jobId, status, sequence])
  @@index([status, nextAttemptAt])
  @@schema("social_media_dashboard")
}

enum IntegrationOAuthAttemptStatus {
  PENDING
  SUCCEEDED
  DENIED
  FAILED
  EXPIRED

  @@schema("social_media_dashboard")
}

model IntegrationConnection {
  id                  String                            @id @default(uuid()) @db.Uuid
  provider            IntegrationProvider
  platformId          String                            @db.Uuid
  platform            Platform                          @relation(fields: [platformId], references: [id], onDelete: Restrict)
  displayName         String                            @db.VarChar(120)
  externalAccountId   String                            @db.VarChar(160)
  credentialReference String                            @db.VarChar(100)
  credentialMode      IntegrationCredentialMode         @default(SERVER_ENVIRONMENT)
  oauthGeneration     Int                               @default(0)
  sourceTimezone      String                            @db.VarChar(100)
  currency            String?                           @db.VarChar(3)
  region              String                            @default("US") @db.VarChar(10)
  active              Boolean                           @default(true)
  autoSync            Boolean                           @default(false)
  nextSyncAt          DateTime                          @default(now())
  leaseToken          String?                           @db.Uuid
  leaseUntil          DateTime?
  configuredByUserId  String                            @db.Uuid
  configuredByUser    User                              @relation(fields: [configuredByUserId], references: [id], onDelete: Restrict)
  mappings            IntegrationMapping[]
  runs                IntegrationRun[]
  oauthCredential     IntegrationOAuthCredential?
  oauthAttempts       IntegrationOAuthAttempt[]
  accountRecords      ConnectedAccountAnalyticsRecord[]
  metricValues        PerformanceMetricValue[]
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([provider, region, externalAccountId])
  @@index([active, autoSync, nextSyncAt])
  @@schema("social_media_dashboard")
}

model IntegrationMapping {
  id                 String                @id @default(uuid()) @db.Uuid
  connectionId       String                @db.Uuid
  connection         IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  campaignPlatformId String                @unique @db.Uuid
  campaignPlatform   CampaignPlatform      @relation(fields: [campaignPlatformId], references: [id], onDelete: Restrict)
  externalCampaignId String                @db.VarChar(160)
  performanceRecords PerformanceRecord[]
  createdAt          DateTime              @default(now())

  @@unique([connectionId, externalCampaignId])
  @@schema("social_media_dashboard")
}

model IntegrationRun {
  id               String                @id @default(uuid()) @db.Uuid
  connectionId     String                @db.Uuid
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  status           IntegrationRunStatus  @default(RUNNING)
  fromDate         DateTime              @db.Date
  toDate           DateTime              @db.Date
  triggeredBy      String                @db.VarChar(20)
  createdRecords   Int                   @default(0)
  updatedRecords   Int                   @default(0)
  unchangedRecords Int                   @default(0)
  conflicts        Int                   @default(0)
  errorCode        String?               @db.VarChar(60)
  summary          Json?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?

  @@index([connectionId, startedAt])
  @@schema("social_media_dashboard")
}

model IntegrationOAuthCredential {
  id                    String                           @id @default(uuid()) @db.Uuid
  connectionId          String                           @unique @db.Uuid
  connection            IntegrationConnection            @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  encryptedTokenBundle  String                           @db.Text
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  grantedScopes         String                           @default("") @db.VarChar(2000)
  status                IntegrationOAuthCredentialStatus @default(CONNECTED)
  connectedAt           DateTime                         @default(now())
  lastRefreshedAt       DateTime?
  lastErrorCode         String?                          @db.VarChar(60)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@index([status, tokenExpiresAt])
  @@schema("social_media_dashboard")
}

model IntegrationOAuthAttempt {
  id                    String                        @id @default(uuid()) @db.Uuid
  connectionId          String                        @db.Uuid
  connection            IntegrationConnection         @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  requestedByUserId     String                        @db.Uuid
  requestedByUser       User                          @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  provider              IntegrationProvider
  oauthGeneration       Int
  stateHash             String                        @unique @db.VarChar(64)
  encryptedPkceVerifier String?                       @db.Text
  status                IntegrationOAuthAttemptStatus @default(PENDING)
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime                      @default(now())

  @@index([connectionId, createdAt])
  @@index([status, expiresAt])
  @@index([requestedByUserId, createdAt])
  @@schema("social_media_dashboard")
}

enum AccountAnalyticsScope {
  ACCOUNT
  CONTENT
  EMAIL_CAMPAIGN

  @@schema("social_media_dashboard")
}

enum AccountAnalyticsDataScope {
  LIFETIME
  DATE_RANGE
  CUMULATIVE

  @@schema("social_media_dashboard")
}

model IntegrationMetricDefinition {
  id                  String                        @id @default(uuid()) @db.Uuid
  provider            IntegrationProvider
  code                String                        @db.VarChar(80)
  scope               AccountAnalyticsScope         @default(ACCOUNT)
  name                String                        @db.VarChar(120)
  description         String
  sourceField         String                        @db.VarChar(120)
  definitionVersion   Int                           @default(1)
  unit                MetricUnit
  aggregationStrategy AggregationStrategy
  weightingMetricCode String?                       @db.VarChar(80)
  nonNegative         Boolean                       @default(true)
  retentionDays       Int?
  active              Boolean                       @default(true)
  metricValues        ConnectedAccountMetricValue[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([provider, code, scope, definitionVersion])
  @@index([provider, scope, active])
  @@schema("social_media_dashboard")
}

model ConnectedAccountAnalyticsRecord {
  id                   String                        @id @default(uuid()) @db.Uuid
  connectionId         String?                       @db.Uuid
  connection           IntegrationConnection?        @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  connectedAccountId   String?                       @db.Uuid
  connectedAccount     ConnectedAccount?             @relation(fields: [connectedAccountId], references: [id], onDelete: Restrict)
  sourceObservationKey String?                       @db.VarChar(512)
  recordDate           DateTime                      @db.Date
  scope                AccountAnalyticsScope         @default(ACCOUNT)
  sourceObjectId       String                        @default("ACCOUNT") @db.VarChar(180)
  objectTitle          String?                       @db.VarChar(500)
  objectType           String?                       @db.VarChar(80)
  objectUrl            String?                       @db.VarChar(1000)
  objectOccurredAt     DateTime?
  periodFrom           DateTime?                     @db.Date
  periodTo             DateTime?                     @db.Date
  dataScope            AccountAnalyticsDataScope?
  sourceApiVersion     String?                       @db.VarChar(80)
  retrievedAt          DateTime                      @default(now())
  metricValues         ConnectedAccountMetricValue[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([connectionId, recordDate, scope, sourceObjectId])
  @@unique([connectedAccountId, sourceObservationKey])
  @@index([connectionId, recordDate])
  @@index([connectedAccountId, scope, recordDate])
  @@index([connectedAccountId, scope, objectOccurredAt])
  @@schema("social_media_dashboard")
}

model ConnectedAccountMetricValue {
  id                  String                          @id @default(uuid()) @db.Uuid
  recordId            String                          @db.Uuid
  record              ConnectedAccountAnalyticsRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  metricDefinitionId  String                          @db.Uuid
  metricDefinition    IntegrationMetricDefinition     @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  value               Decimal                         @db.Decimal(24, 6)
  sourceDataExpiresAt DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([recordId, metricDefinitionId])
  @@index([sourceDataExpiresAt])
  @@schema("social_media_dashboard")
}

model PerformanceMetricValue {
  id                  String                 @id @default(uuid()) @db.Uuid
  performanceRecordId String                 @db.Uuid
  performanceRecord   PerformanceRecord      @relation(fields: [performanceRecordId], references: [id])
  metricDefinitionId  String                 @db.Uuid
  metricDefinition    MetricDefinition       @relation(fields: [metricDefinitionId], references: [id])
  sourceConnectionId  String?                @db.Uuid
  sourceConnection    IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: Restrict)
  value               Decimal                @db.Decimal(24, 6)
  sourceDataExpiresAt DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([performanceRecordId, metricDefinitionId])
  @@index([sourceConnectionId, sourceDataExpiresAt])
  @@schema("social_media_dashboard")
}

model KpiDefinition {
  id                 String           @id @default(uuid()) @db.Uuid
  metricDefinitionId String           @db.Uuid
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id])
  name               String
  description        String?
  active             Boolean          @default(true)
  targets            KpiTarget[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([metricDefinitionId])
  @@schema("social_media_dashboard")
}

model KpiTarget {
  id              String            @id @default(uuid()) @db.Uuid
  kpiDefinitionId String            @db.Uuid
  kpiDefinition   KpiDefinition     @relation(fields: [kpiDefinitionId], references: [id])
  periodType      TargetPeriodType
  targetValue     Decimal           @db.Decimal(18, 6)
  scopeType       TargetScopeType   @default(GLOBAL)
  channelId       String?           @db.Uuid
  channel         MarketingChannel? @relation(fields: [channelId], references: [id])
  platformId      String?           @db.Uuid
  platform        Platform?         @relation(fields: [platformId], references: [id])
  campaignId      String?           @db.Uuid
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  comparisonRule  ComparisonRule
  effectiveFrom   DateTime          @db.Date
  effectiveTo     DateTime?         @db.Date
  createdByUserId String            @db.Uuid
  createdByUser   User              @relation("CreatedTargets", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@schema("social_media_dashboard")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
  @@schema("social_media_dashboard")
}

model PasswordRecoveryToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash    String    @unique
  emailAtIssue String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?

  @@index([userId, usedAt, revokedAt, expiresAt])
  @@schema("social_media_dashboard")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@schema("social_media_dashboard")
}

model ImportBatch {
  id                          String                  @id @default(uuid()) @db.Uuid
  sourceType                  String?
  sourcePlatform              String?
  displayName                 String?
  originalFilename            String
  mimeType                    String?
  checksum                    String
  importedByUserId            String                  @db.Uuid
  importedByUser              User                    @relation(fields: [importedByUserId], references: [id])
  status                      ImportBatchStatus       @default(PREVIEW)
  totalRows                   Int                     @default(0)
  acceptedRows                Int                     @default(0)
  rejectedRows                Int                     @default(0)
  warningCount                Int                     @default(0)
  errorSummary                Json?
  mapping                     Json?
  selectedSheet               String?
  datasetCampaignId           String?                 @db.Uuid
  datasetOperation            DatasetImportOperation?
  targetDatasetId             String?                 @db.Uuid
  expectedDatasetVersion      Int?
  datasetAttemptStartedAt     DateTime?
  datasetAttemptInvalidatedAt DateTime?
  completedAt                 DateTime?
  rows                        ImportRow[]
  performanceRecords          PerformanceRecord[]
  datasetRevision             DatasetRevision?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@index([checksum])
  @@index([importedByUserId, createdAt])
  @@schema("social_media_dashboard")
}

model ImportRow {
  id                String          @id @default(uuid()) @db.Uuid
  importBatchId     String          @db.Uuid
  importBatch       ImportBatch     @relation(fields: [importBatchId], references: [id])
  sourceRowNumber   Int
  sheetName         String?
  status            ImportRowStatus @default(PENDING)
  rawData           Json
  rawCells          Json?
  normalizedPreview Json?
  errors            Json?
  warnings          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([importBatchId, sourceRowNumber, sheetName])
  @@index([importBatchId, status])
  @@schema("social_media_dashboard")
}

model Dataset {
  id                   String                      @id @default(uuid()) @db.Uuid
  campaignId           String                      @db.Uuid
  campaign             Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  name                 String                      @db.VarChar(240)
  sourceFilename       String                      @db.VarChar(500)
  sourceChecksum       String                      @db.Char(64)
  worksheetKey         String                      @db.VarChar(255)
  worksheetName        String?                     @db.VarChar(255)
  currentRevision      Int                         @default(1)
  version              Int                         @default(1)
  managementCapability DatasetManagementCapability @default(MANAGEABLE)
  createdByUserId      String                      @db.Uuid
  createdByUser        User                        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  revisions            DatasetRevision[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([campaignId, sourceChecksum, worksheetKey])
  @@index([campaignId, createdAt, id])
  @@schema("social_media_dashboard")
}

model DatasetRevision {
  id                String       @id @default(uuid()) @db.Uuid
  datasetId         String       @db.Uuid
  dataset           Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  revisionNumber    Int
  importBatchId     String       @unique @db.Uuid
  importBatch       ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  sourceFilename    String       @db.VarChar(500)
  sourceChecksum    String       @db.Char(64)
  worksheetKey      String       @db.VarChar(255)
  worksheetName     String?      @db.VarChar(255)
  headerFingerprint String       @db.Char(64)
  columns           Json
  rowCount          Int
  rows              DatasetRow[]
  createdAt         DateTime     @default(now())

  @@unique([datasetId, revisionNumber])
  @@index([datasetId, createdAt])
  @@schema("social_media_dashboard")
}

model DatasetRow {
  id              String          @id @default(uuid()) @db.Uuid
  revisionId      String          @db.Uuid
  revision        DatasetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceRowNumber Int
  cells           Json
  typedCells      Json
  createdAt       DateTime        @default(now())

  @@unique([revisionId, sourceRowNumber])
  @@schema("social_media_dashboard")
}

model DatasetImportTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(120)
  headerFingerprint String   @db.Char(64)
  rules             Json
  createdByUserId   String   @db.Uuid
  createdByUser     User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([createdByUserId, name])
  @@index([createdByUserId, headerFingerprint])
  @@schema("social_media_dashboard")
}

model DatasetDeletionFence {
  id             String   @id @default(uuid()) @db.Uuid
  campaignId     String   @db.Uuid
  sourceChecksum String   @db.Char(64)
  worksheetKey   String   @db.VarChar(255)
  deletedAt      DateTime @default(now())

  @@unique([campaignId, sourceChecksum, worksheetKey])
  @@index([deletedAt])
  @@schema("social_media_dashboard")
}

model ArchiveDeletionConfirmation {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  actorUserId String    @db.Uuid
  entityKind  String    @db.VarChar(20)
  entityId    String    @db.Uuid
  fingerprint String    @db.Char(64)
  typedText   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@schema("social_media_dashboard")
}

model DeletedPerformanceKey {
  id                 String   @id @default(uuid()) @db.Uuid
  campaignPlatformId String   @db.Uuid
  recordDate         DateTime @db.Date
  deletedRecordId    String   @db.Uuid
  deletedAt          DateTime @default(now())

  @@unique([campaignPlatformId, recordDate])
  @@schema("social_media_dashboard")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("social_media_dashboard")
}

model RegistrationRequest {
  id               String              @id @default(uuid()) @db.Uuid
  email            String              @unique @db.VarChar(254)
  name             String              @db.VarChar(120)
  passwordHash     String?
  status           AccessRequestStatus @default(PENDING)
  reviewedByUserId String?             @db.Uuid
  reviewedAt       DateTime?
  approvedUserId   String?             @db.Uuid
  createdAt        DateTime            @default(now())

  @@schema("social_media_dashboard")
}

model UserInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @db.VarChar(254)
  roleId          String    @db.Uuid
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUserId String    @db.Uuid
  tokenHash       String    @unique @db.Char(64)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([email, expiresAt])
  @@schema("social_media_dashboard")
}
